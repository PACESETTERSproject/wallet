{
	"name": "wallet",
	"version": "2.1.2",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "paraglide-js compile --project ./project.inlang && vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"no-literals": "eslint .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"lint": "prettier --plugin-search-dir . --check .",
		"format": "prettier --plugin-search-dir . --write .",
		"ionic:build": "npm run build",
		"ionic:serve": "npm run dev -- --host",
		"ios": "ionic cap run ios -l --external",
		"android": "ionic cap run android -l --external",
		"apk": "ionic capacitor sync android && cd android && ./gradlew assembleDebug && ./gradlew installDebug && cd ..",
		"apk:waydroid": "ionic capacitor sync android && cd android && ./gradlew assembleDebug && cd .. && waydroid app install android/app/build/outputs/apk/debug/app-debug.apk",
		"web": "ionic serve",
		"icons": "npx capacitor-assets generate --ios --android",
		"postinstall": "paraglide-js compile --project ./project.inlang && cp -r ./node_modules/@pacesetters/components/dist/. ./static/components",
		"archive": "tar -czf wallet.tar.gz build node_modules package.json static vite.config.ts .env .svelte-kit"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^7.6.9",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.5",
		"@inlang/paraglide-js": "1.11.8",
		"@lottiefiles/svelte-lottie-player": "^0.3.1",
		"@pacesetters/components": "link:../pacesetters-components",
		"@playwright/test": "^1.63.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^11.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^9.2.6",
		"@semantic-release/npm": "^11.0.3",
		"@semantic-release/release-notes-generator": "^12.1.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/eslint": "8.56.5",
		"@types/lodash": "^4.17.25",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"autoprefixer": "^10.6.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-localization": "file:plugins/localization",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"postcss": "^8.5.28",
		"postcss-load-config": "^5.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-organize-imports": "^3.2.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.5.14",
		"semantic-release": "^23.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"dependencies": {
		"@aparajita/capacitor-biometric-auth": "^8.0.2",
		"@capacitor-mlkit/barcode-scanning": "7.0.0-next.4",
		"@capacitor/android": "^7.6.9",
		"@capacitor/app": "^7.1.2",
		"@capacitor/browser": "^7.0.5",
		"@capacitor/camera": "^7.0.5",
		"@capacitor/clipboard": "^7.0.4",
		"@capacitor/core": "^7.6.9",
		"@capacitor/device": "^7.0.5",
		"@capacitor/filesystem": "^7.1.8",
		"@capacitor/haptics": "^7.0.5",
		"@capacitor/ios": "^7.6.9",
		"@capacitor/keyboard": "^7.0.6",
		"@capacitor/network": "^7.0.4",
		"@capacitor/preferences": "^7.0.4",
		"@capacitor/share": "^7.0.4",
		"@capacitor/status-bar": "^7.0.6",
		"@capawesome/capacitor-android-edge-to-edge-support": "^7.2.3",
		"@fontsource-variable/gantari": "^5.3.0",
		"@inlang/paraglide-js-adapter-sveltekit": "^0.6.7",
		"@ionic/cli": "^7.2.1",
		"@ionic/core": "^7.8.6",
		"@slangroom/core": "^1.51.1",
		"@slangroom/did": "^1.51.1",
		"@slangroom/helpers": "^1.51.1",
		"@slangroom/http": "^1.51.1",
		"@slangroom/pocketbase": "^1.51.1",
		"@slangroom/rdf": "^1.51.1",
		"@slangroom/zencode": "^1.51.1",
		"ajv": "^8.20.0",
		"ajv-formats": "^2.1.1",
		"capacitor-native-settings": "^6.0.6",
		"dayjs": "^1.11.23",
		"ionic-svelte": "^0.5.85",
		"ionicons": "^7.4.0",
		"lodash": "^4.18.1",
		"swiper": "12.2.0",
		"zenroom": "^5.38.1",
		"zod": "^3.25.76"
	}
}
